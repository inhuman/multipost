{"theorems":
 [{"statement":
   "∀ (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (res : NoDoublePost.Result),\n  (NoDoublePost.run NoDoublePost.Record.posted b rm res Bool.false).attempted = Bool.false ∧\n    (NoDoublePost.run NoDoublePost.Record.pending b NoDoublePost.Remote.found res Bool.false).attempted = Bool.false",
   "name": "NoDoublePost.no_double_post",
   "axioms": ["propext"]},
  {"statement":
   "∀ (b : NoDoublePost.FoundBy) (res : NoDoublePost.Result),\n  NoDoublePost.run NoDoublePost.Record.pending b NoDoublePost.Remote.cannotList res Bool.false =\n    { attempted := Bool.false, journaledFirst := Bool.false, record := NoDoublePost.Record.pending, warned := Bool.true,\n      failed := Bool.true, nextAttempted := Bool.true }",
   "name": "NoDoublePost.unknown_never_retried_blindly",
   "axioms": ["propext"]},
  {"statement":
   "∀ (r : NoDoublePost.Record) (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (res : NoDoublePost.Result)\n  (f : Bool),\n  (NoDoublePost.run r b rm res f).attempted = Bool.true → (NoDoublePost.run r b rm res f).journaledFirst = Bool.true",
   "name": "NoDoublePost.journaled_before_publish",
   "axioms": ["propext"]},
  {"statement":
   "∀ (r : NoDoublePost.Record) (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (res : NoDoublePost.Result)\n  (f : Bool),\n  (NoDoublePost.run r b rm res f).attempted = Bool.true →\n    res.sent? = Bool.true → (NoDoublePost.run r b rm res f).record ≠ NoDoublePost.Record.none",
   "name": "NoDoublePost.maybe_sent_never_forgotten",
   "axioms": ["propext"]},
  {"statement":
   "∀ (r : NoDoublePost.Record) (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (f : Bool),\n  (NoDoublePost.run r b rm NoDoublePost.Result.rejected f).attempted = Bool.true →\n    (NoDoublePost.run r b rm NoDoublePost.Result.rejected f).record = r",
   "name": "NoDoublePost.rejected_changes_nothing",
   "axioms": ["propext"]},
  {"statement":
   "∀ (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (res : NoDoublePost.Result) (f : Bool),\n  (NoDoublePost.run NoDoublePost.Record.posted b rm res f).record = NoDoublePost.Record.posted",
   "name": "NoDoublePost.posted_never_lost",
   "axioms": ["propext"]},
  {"statement":
   "∀ (b : NoDoublePost.FoundBy) (res : NoDoublePost.Result),\n  (NoDoublePost.run NoDoublePost.Record.pending b NoDoublePost.Remote.found res Bool.false).record =\n      NoDoublePost.Record.posted ∧\n    (NoDoublePost.run NoDoublePost.Record.pending b NoDoublePost.Remote.found res Bool.false).warned = Bool.true",
   "name": "NoDoublePost.found_is_recorded",
   "axioms": ["propext"]},
  {"statement":
   "∀ (r : NoDoublePost.Record) (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (res : NoDoublePost.Result)\n  (f : Bool),\n  (NoDoublePost.run r b rm res f).failed = Bool.true ↔\n    (NoDoublePost.run r b rm res f).attempted = Bool.true ∧ res ≠ NoDoublePost.Result.ok ∨\n      f = Bool.false ∧ r = NoDoublePost.Record.pending ∧ rm = NoDoublePost.Remote.cannotList",
   "name": "NoDoublePost.fails_iff",
   "axioms": ["propext"]},
  {"statement":
   "∀ (r : NoDoublePost.Record) (b : NoDoublePost.FoundBy) (rm : NoDoublePost.Remote) (res : NoDoublePost.Result)\n  (f : Bool), (NoDoublePost.run r b rm res f).nextAttempted = Bool.true",
   "name": "NoDoublePost.next_always_runs",
   "axioms": ["propext"]}],
