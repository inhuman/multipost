{"theorems":
 [{"statement":
   "∀ (ar : NoDoublePost.Result) (bp : Bool) (br : NoDoublePost.Result),\n  ¬NoDoublePost.Target.a ∈ (NoDoublePost.run Bool.true ar bp br Bool.false).attempted",
   "name": "NoDoublePost.no_double_post",
   "axioms": ["propext"]},
  {"statement":
   "∀ (bp : Bool) (br : NoDoublePost.Result) (f : Bool),\n  ¬NoDoublePost.Target.a ∈ (NoDoublePost.run Bool.false NoDoublePost.Result.fail bp br f).recorded",
   "name": "NoDoublePost.failure_not_recorded",
   "axioms": ["propext"]},
  {"statement":
   "∀ (ap : Bool) (br : NoDoublePost.Result) (f : Bool),\n  ap = Bool.false ∨ f = Bool.true →\n    NoDoublePost.Target.b ∈ (NoDoublePost.run ap NoDoublePost.Result.fail Bool.false br f).attempted",
   "name": "NoDoublePost.failure_does_not_stop_others",
   "axioms": ["propext"]},
  {"statement":
   "∀ (ap bp : Bool) (br : NoDoublePost.Result) (f : Bool),\n  ap = Bool.false ∨ f = Bool.true →\n    NoDoublePost.Target.a ∈ (NoDoublePost.run ap NoDoublePost.Result.ok bp br f).recorded",
   "name": "NoDoublePost.success_recorded",
   "axioms": ["propext"]},
  {"statement":
   "∀ (ap : Bool) (ar : NoDoublePost.Result) (bp : Bool) (br : NoDoublePost.Result) (f : Bool),\n  (NoDoublePost.run ap ar bp br f).failed = Bool.true ↔\n    (NoDoublePost.step ap ar f).fst = Bool.true ∧ ar = NoDoublePost.Result.fail ∨\n      (NoDoublePost.step bp br f).fst = Bool.true ∧ br = NoDoublePost.Result.fail",
   "name": "NoDoublePost.fails_iff_attempt_failed",
   "axioms": ["propext"]},
  {"statement":
   "∀ (ar : NoDoublePost.Result) (bp : Bool) (br : NoDoublePost.Result) (f : Bool),\n  NoDoublePost.Target.a ∈ (NoDoublePost.run Bool.true ar bp br f).recorded",
   "name": "NoDoublePost.record_never_lost",
   "axioms": ["propext"]}],
