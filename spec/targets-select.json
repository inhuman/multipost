{"theorems":
 [{"statement":
   "∀ (tg : TargetSelect.Tg) (mx : TargetSelect.MaxCfg) (boosty : TargetSelect.Boosty) (req : TargetSelect.Request)\n  (t : TargetSelect.Target),\n  t ∈ (TargetSelect.choose tg mx boosty req).selected → TargetSelect.setup tg mx boosty t = TargetSelect.Setup.ready",
   "name": "TargetSelect.never_selects_unready",
   "axioms": ["propext"]},
  {"statement":
   "∀ (tg : TargetSelect.Tg) (mx : TargetSelect.MaxCfg) (boosty : TargetSelect.Boosty) (req : TargetSelect.Request),\n  (TargetSelect.choose tg mx boosty req).failed = Bool.true → (TargetSelect.choose tg mx boosty req).selected = []",
   "name": "TargetSelect.failure_posts_nowhere",
   "axioms": ["propext"]},
  {"statement":
   "∀ (tg : TargetSelect.Tg) (mx : TargetSelect.MaxCfg) (boosty : TargetSelect.Boosty) (req : TargetSelect.Request),\n  req ≠ TargetSelect.Request.byDefault →\n    (TargetSelect.choose tg mx boosty req).failed = Bool.false →\n      (TargetSelect.choose tg mx boosty req).selected = TargetSelect.named req",
   "name": "TargetSelect.named_is_all_or_nothing",
   "axioms": ["propext"]},
  {"statement":
   "∀ (tg : TargetSelect.Tg) (mx : TargetSelect.MaxCfg) (boosty : TargetSelect.Boosty) (t : TargetSelect.Target),\n  mx ≠ TargetSelect.MaxCfg.badId →\n    TargetSelect.setup tg mx boosty t = TargetSelect.Setup.ready →\n      t ∈ (TargetSelect.choose tg mx boosty TargetSelect.Request.byDefault).selected",
   "name": "TargetSelect.default_takes_every_ready",
   "axioms": ["propext"]},
  {"statement":
   "∀ (tg : TargetSelect.Tg) (boosty : TargetSelect.Boosty) (req : TargetSelect.Request),\n  TargetSelect.Target.max ∈ TargetSelect.named req →\n    (TargetSelect.choose tg TargetSelect.MaxCfg.badId boosty req).failed = Bool.true",
   "name": "TargetSelect.typo_is_loud",
   "axioms": ["propext"]},
  {"statement":
   "∀ (mx : TargetSelect.MaxCfg) (boosty : TargetSelect.Boosty),\n  TargetSelect.choose TargetSelect.Tg.ready mx boosty TargetSelect.Request.onlyTg =\n    { selected := [TargetSelect.Target.tg], failed := Bool.false }",
   "name": "TargetSelect.unasked_does_not_block",
   "axioms": ["propext"]}],
